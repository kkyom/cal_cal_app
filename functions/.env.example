# 공공데이터 식품영양성분DB 인증키
FOOD_API_KEY=

# Google AI Studio / Gemini API 키 (영양성분표 인식)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# App Store 구독 검증 환경. "production"으로 설정하기 전까지는 항상 sandbox로
# 동작한다(실기기 테스트/TestFlight는 전부 sandbox). 실제 심사 통과 후에만 바꿀 것.
# 값: sandbox(기본) | production
APP_STORE_ENVIRONMENT=sandbox

# 아래 3개는 여기(.env)가 아니라 Secret Manager로 관리한다.
# App Store Connect > Users and Access > Integrations > In-App Purchase 키에서 발급:
#   firebase functions:secrets:set APP_STORE_ISSUER_ID
#   firebase functions:secrets:set APP_STORE_KEY_ID
#   firebase functions:secrets:set APP_STORE_PRIVATE_KEY   # .p8 파일 내용 그대로 붙여넣기

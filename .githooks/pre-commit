#!/usr/bin/env bash
# 커밋 전 로컬 검증 훅. CI(.github/workflows/ci.yml)와 같은 검사를
# 스테이징된 파일에 해당하는 부분만 돌린다.
#
# 설치:  git config core.hooksPath .githooks
# 건너뛰기(급할 때만):  git commit --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

fail() {
  echo ""
  echo "✖ pre-commit: $1"
  echo "  고친 뒤 다시 커밋하거나, 급하면 git commit --no-verify 로 건너뛸 수 있습니다."
  exit 1
}

# --- Flutter: Dart 코드나 의존성·분석 설정이 바뀐 경우 ---
if echo "$staged" | grep -qE '\.dart$|^pubspec\.(yaml|lock)$|^analysis_options\.yaml$'; then
  command -v flutter >/dev/null 2>&1 || fail "flutter 명령을 찾을 수 없습니다(PATH 확인)."
  if [ ! -f lib/firebase_options.dart ]; then
    fail "lib/firebase_options.dart가 없습니다. flutterfire configure로 만들어 주세요."
  fi

  echo "▶ flutter analyze lib test"
  flutter analyze lib test || fail "flutter analyze에서 문제가 발견됐습니다."

  echo "▶ flutter test"
  flutter test || fail "flutter test가 실패했습니다."
fi

# --- Cloud Functions: functions/ 아래 JS가 바뀐 경우 ---
if echo "$staged" | grep -qE '^functions/.*\.(js|json)$'; then
  command -v node >/dev/null 2>&1 || fail "node 명령을 찾을 수 없습니다(PATH 확인)."

  echo "▶ functions 문법 검사"
  for f in functions/*.js; do
    node --check "$f" || fail "$f 문법 오류"
  done

  if [ -d functions/node_modules ]; then
    echo "▶ functions 모듈 로드"
    (cd functions && node -e "require('./index.js')") || fail "functions/index.js 로드 실패"
  else
    echo "  (functions/node_modules 없음: 모듈 로드 검사는 건너뜀. cd functions && npm ci)"
  fi
fi

echo "✔ pre-commit 검사 통과"
